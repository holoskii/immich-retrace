# Immich's base URL as the viewer's server reaches it (not the browser), without /api.
# Same compose network as Immich: http://immich-server:2283. Otherwise e.g. http://192.168.1.10:2283.
IMMICH_URL=http://immich-server:2283
# Immich → Account Settings → API Keys → New API Key, with exactly these permissions:
# asset.read, asset.view, album.read
IMMICH_API_KEY=
# Optional: Immich's public URL (as the browser reaches it) for "Open in Immich" links; unset = no links.
# IMMICH_PUBLIC_URL=https://photos.example.com
# Optional: MapLibre style JSON URL. Default: OpenFreeMap's dark style, https://tiles.openfreemap.org/styles/dark
# MAP_STYLE_URL=
