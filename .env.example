# Immich as seen from inside self_hosting_network (through the on-demand gate).
IMMICH_URL=http://immich_gate:2284
# Immich → Account Settings → API Keys, permissions: asset.read, asset.view, album.read
IMMICH_API_KEY=
# Optional: Immich's public URL (as the browser reaches it) for "Open in Immich" links; unset = no links.
# IMMICH_PUBLIC_URL=https://photos.example.com
# Optional: MapLibre style JSON. Default: Immich's dark style, https://tiles.immich.cloud/v1/style/dark.json
# (for a public deployment prefer OpenFreeMap, e.g. https://tiles.openfreemap.org/styles/dark, or self-hosted PMTiles).
# MAP_STYLE_URL=
